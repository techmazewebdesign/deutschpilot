{
  "expo": {
    "name": "DeutschPilot",
    "slug": "deutschpilot",
    "scheme": "deutschpilot",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/logo.png",
    "ios": {
      "supportsTablet": true,
      "appleTeamId": "HYBTH9WZQ6",
      "buildNumber": "5",
      "bundleIdentifier": "de.deutschpilot.app",
      "googleServicesFile": "./config/GoogleService-Info.plist"
    },
    "android": {
      "package": "de.deutschpilot.app",
      "predictiveBackGestureEnabled": true,
      "versionCode": 5,
      "allowBackup": false,
      "usesCleartextTraffic": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.771631677984-aib6g6jmhdn1vf8cn8cnr3aa4b3ko5ha"
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "school"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e0a04b84-7aee-4be8-8c49-4fff33bbb0e8"
      }
    },
    "owner": "roozos"
  }
