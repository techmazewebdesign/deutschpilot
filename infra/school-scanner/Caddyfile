{
    email {$TLS_OPERATOR_EMAIL}
    admin off
    auto_https disable_redirects
    servers {
        protocols h1 h2
    }
}
https://{$SCANNER_DOMAIN} {
    tls {
        issuer acme {
            disable_http_challenge
        }
    }
    request_body {
        max_size 10MB
    }
    @scan {
        method POST
        path /scan
    }
    handle @scan {
        reverse_proxy adapter:3311
    }
    handle {
        respond 404
    }
}
